    <releases>
      <release type="stable" version="50.0" timestamp="1787702400">
        <description>
          <p>The first Convey release, forked from Geary 46.0.</p>
          <p>Enhancements included in this release:</p>
          <ul>
            <li>Ported the interface to GTK4 and libadwaita</li>
            <li>Added a Microsoft Graph backend for Outlook and Microsoft 365 accounts</li>
            <li>Rebranded as Convey, with new application icons</li>
            <li>Create, rename and delete folders from the sidebar</li>
            <li>Reworked conversation list with keyboard navigation between panes</li>
            <li>Message colours now follow the system light and dark preference immediately</li>
            <li>Redrawn notification avatars, rendered at the display&apos;s pixel density</li>
            <li>Reworked address completion as a navigable dropdown</li>
            <li>Ported plugins to libpeas-2 and migrated to gcr-4 and gck-2</li>
            <li>Numerous bug fixes and user interface improvements</li>
          </ul>
        </description>
      </release>
    </releases>
    <content_rating type="oars-1.1">
      <content_attribute id="social-contacts">intense</content_attribute>
    </content_rating>
    <bundle type="flatpak" runtime="org.gnome.Platform/x86_64/50" sdk="org.gnome.Sdk/x86_64/50">app/net.donnybeelo.Convey/x86_64/stable</bundle>
  </component><component type="desktop-application">
    <id>net.donnybeelo.WhatsApp</id>
    <name>WhatsApp</name>
    <summary>Unofficial WhatsApp desktop client</summary>
    <project_license>ISC</project_license>
    <description>
      <p>
      An unofficial desktop client for WhatsApp Web, built with Electron. Adds
      a tray icon, native desktop notifications, window state memory and a
      background start mode.
    </p>
      <p>Not affiliated with or endorsed by WhatsApp LLC or Meta.</p>
    </description>
    <developer id="net.donnybeelo">
      <name>Daniel Elia</name>
    </developer>
    <developer_name>Daniel Elia</developer_name>
    <launchable type="desktop-id">net.donnybeelo.WhatsApp.desktop</launchable>
    <icon type="cached" width="64" height="64">net.donnybeelo.WhatsApp.png</icon>
